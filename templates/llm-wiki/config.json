{
  "version": 1,
  "wiki_root": "llm-wiki",
  "_meta": {
    "setup_completed": false,
    "setup_date": null,
    "setup_version": null,
    "_comment": "Set by wiki-setup wizard. When setup_completed=true, skills skip the 'run setup first' warning."
  },
  "persona": {
    "name": "Gennie"
  },
  "viewer": {
    "enabled": true,
    "port": 8765,
    "og_base_url": "",
    "open_file_scheme": "file"
  },
  "graph": {
    "port": 8890,
    "tag_edges": true,
    "include_raw_nodes": true,
    "curated_by_edges": true
  },
  "integrations": {
    "firecrawl": {
      "enabled": true,
      "api_key_env": "FIRECRAWL_API_KEY",
      "api_base_url": "https://api.firecrawl.dev",
      "_comment": "Clean markdown from any URL. Get key: https://firecrawl.dev/app/api-keys"
    },
    "perplexity": {
      "enabled": true,
      "api_key_env": "PERPLEXITY_API_KEY",
      "model": "sonar",
      "_comment": "AI-powered research queries. Get key: https://www.perplexity.ai/settings/api"
    },
    "twitter": {
      "enabled": false,
      "api_key_env": "TWITTER_AUTH_TOKEN",
      "prefer_cli": true,
      "_comment": "Fetch tweets/threads/search. Install bird CLI: npm install -g @steipete/bird — zero config for public tweets via FxTwitter API (no token needed). Get auth_token from browser DevTools → Application → Cookies."
    },
    "brave": {
      "enabled": true,
      "api_key_env": "BRAVE_SEARCH_API_KEY",
      "default_mode": "llm-context",
      "default_count": 10,
      "_comment": "Brave Search API — best for RAG grounding. Modes: web | news | llm-context | answers. Free key: https://api.search.brave.com"
    },
    "annas_archive": {
      "enabled": false,
      "api_key_env": "ANNAS_ARCHIVE_KEY",
      "_comment": "Anna's Archive — fast ebook/paper downloads. Requires membership. https://annas-archive.org/account"
    }
  },
  "git": {
    "enabled": true,
    "init_on_setup": true,
    "snapshot_after_ingest": false,
    "snapshot_after_build": false,
    "snapshot_message_prefix": "[ingest]",
    "include_diff_in_skill_context": false,
    "tracked_globs": [
      "wiki/",
      "raw/",
      "CLAUDE.md",
      "config.json"
    ],
    "lifecycle": {
      "phases": {
        "ingest": "[ingest]",
        "prepare": "[prepare]",
        "wiki": "[wiki]",
        "build": "[build]",
        "graph": "[graph]",
        "research": "[research]",
        "config": "[config]"
      }
    }
  },
  "research_loop": {
    "enabled": false,
    "max_items_per_run": 8,
    "tasks_file": "research-tasks.json",
    "delay_seconds_between_fetches": 1.0
  },
  "ingestion_security": {
    "enabled": true,
    "block_on_suspected": false,
    "log_to_raw_frontmatter": true,
    "llm_triage": false
  },
  "ingestion_tagging": {
    "enabled": true,
    "auto_detect": true,
    "llm_detect": false
  },
  "ingestion_dedup": {
    "enabled": true,
    "block_on_duplicate": false
  },
  "hooks": {
    "sound": {
      "enabled": false,
      "command": [
        "afplay",
        "/System/Library/Sounds/Glass.aiff"
      ],
      "on_ingest": true,
      "on_research_loop": true,
      "timeout_seconds": 30
    }
  },
  "pdf": {
    "max_cost_usd": 1.00
  }
}