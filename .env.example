# wiki-llm — environment variables
#
# Full reference: docs/ENV.md
#
# ── Claude Code + this plugin ────────────────────────────────────────────────
# Prefer project-local:  .claude/settings.local.json  (gitignored — put secrets here)
# Or global:             ~/.claude/settings.json
# In that JSON, use an "env" block so tools inherit the same variables as below.
# Ask Claude to open the file and add the keys (empty strings) so you can paste values.
#
# Example shape:
#   {
#     "env": {
#       "BRAVE_SEARCH_API_KEY": "",
#       "FIRECRAWL_API_KEY": "",
#       "PERPLEXITY_API_KEY": "",
#       "TWITTER_AUTH_TOKEN": "",
#       "ANTHROPIC_API_KEY": "",
#       "OPENAI_API_KEY": ""
#     }
#   }
#
# ── Terminal / scripts / pytest ───────────────────────────────────────────────
# Copy this file to .env and/or .env.local and fill in your values.
# Both are gitignored — never commit real keys.
#
# llm-wiki CLI: `bin/llm-wiki` / `python3 scripts/llm_wiki.py` loads .env then .env.local
# from the plugin repo root automatically (shell exports still win). Set LLM_WIKI_SKIP_DOTENV=1
# to disable. You can still use: source .env.local  or  direnv  if you prefer.

# ── Vault ────────────────────────────────────────────────────────────────────
# Override default vault discovery (CLI also accepts --vault)
# LLM_WIKI_VAULT=/path/to/your/project/llm-wiki

# ── Disable auto-loading of .env / .env.local ─────────────────────────────────
# LLM_WIKI_SKIP_DOTENV=1

# ── Web search ───────────────────────────────────────────────────────────────
# Brave Search API — web/news/llm-context/answers modes (best for RAG grounding)
# Free key: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# ── Web scraping ─────────────────────────────────────────────────────────────
# Firecrawl — clean markdown from any URL (CLI or REST API)
# Get a free key: https://firecrawl.dev/app/api-keys
# Install CLI:    npm install -g firecrawl-cli && firecrawl login
FIRECRAWL_API_KEY=

# ── AI research ──────────────────────────────────────────────────────────────
# Perplexity — AI-powered research queries
# Get a key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Social / data MCPs ───────────────────────────────────────────────────────
# Twitter/X auth_token cookie — for bird CLI (tweet/thread/search/timeline ingest)
# Get it: Twitter → DevTools → Application → Cookies → auth_token
# Install bird: npm install -g @steipete/bird
# NOTE: FxTwitter API works zero-config for public tweets (no token needed)
TWITTER_AUTH_TOKEN=

# ── LLM backends ─────────────────────────────────────────────────────────────
# Anthropic (Claude Vision PDF ingest, pdf-marker, benchmarks when configured)
ANTHROPIC_API_KEY=

# OpenAI (embeddings, MarkItDown path, benchmark LLM rerank when rerank_llm.invoke is openai_api)
OPENAI_API_KEY=

# Google Gemini (pdf-marker --llm-service gemini); alias: GEMINI_API_KEY
# GOOGLE_API_KEY=

# ── PDF marker (advanced) ────────────────────────────────────────────────────
# Optional override for marker subprocess prompt
# LLM_WIKI_MARKER_BLOCK_PROMPT=

# ── Benchmarks ───────────────────────────────────────────────────────────────
# LLM rerank during benchmark runs (also configurable via config.json)
# LLM_WIKI_BENCHMARK_LLM=1
# Verbose rerank debug (see benchmarks/lme_bench.py)
# LLM_WIKI_BENCHMARK_DEBUG_RERANK=1

# ── Pytest / smoke-test (opt-in tiers) ───────────────────────────────────────
# RUN_NETWORK_TESTS=1
# RUN_CLAUDE_TESTS=1
# RUN_CODEX_SKILL_EVALS=1
# RUN_BROWSER_TESTS=1
# RUN_MINIMAL_SKILL_EVALS=1
# RUN_RERANK_SMOKE=1

# ── Claude skill-eval tests & qa_record.py only ─────────────────────────────
# CLAUDE_RUNNER_SETTING_SOURCES=project
# CLAUDE_RUNNER_KEEP_ANTHROPIC_ENV=1
# SKILL_EVAL_BACKEND=claude

# ── Hooks (Claude Code SessionEnd, opt-in) ─────────────────────────────────
# LLM_WIKI_CLEANUP_NPX=1

# ── Optional extract / niche skills (see docs/ENV.md + skills/wiki-*/SKILL.md) ─
# Anna's Archive — wiki-extract-annas
# ANNAS_ARCHIVE_KEY=

# Crunchbase — wiki-extract-crunchbase
# CRUNCHBASE_API_KEY=

# GitHub API — wiki-extract-github
# GITHUB_TOKEN=

# Podcast Index + AssemblyAI — wiki-extract-podcast
# PODCAST_INDEX_KEY=
# PODCAST_INDEX_SECRET=
# ASSEMBLYAI_API_KEY=

# NewsAPI (optional, wiki-setup / news flows)
# NEWS_API_KEY=

# Amazon Product Advertising API (optional, wiki-extract-ecommerce)
# AMAZON_PA_API_KEY=

# ── Session memory ────────────────────────────────────────────────────────────
# Enabled in llm-wiki/config.json (memory.enabled, memory.max_sessions, …) — not
# env vars. Recall uses the vault search backend; see docs/ENV.md § Session memory.
