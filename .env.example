# wiki-llm integration API keys
#
# ── Claude Code + this plugin ────────────────────────────────────────────────
# Prefer project-local:  .claude/settings.local.json  (gitignored — put secrets here)
# Or global:             ~/.claude/settings.json
# In that JSON, use an "env" block so tools inherit the same variables as below.
# Ask Claude to open the file and add the keys (empty strings) so you can paste values.
#
# Example shape:
#   {
#     "env": {
#       "BRAVE_SEARCH_API_KEY": "",
#       "FIRECRAWL_API_KEY": "",
#       "PERPLEXITY_API_KEY": "",
#       "TWITTER_AUTH_TOKEN": "",
#       "ANTHROPIC_API_KEY": "",
#       "OPENAI_API_KEY": ""
#     }
#   }
#
# ── Terminal / scripts / pytest ───────────────────────────────────────────────
# Copy this file to .env and/or .env.local and fill in your values.
# Both are gitignored — never commit real keys.
#
# llm-wiki CLI: `bin/llm-wiki` / `python3 scripts/llm_wiki.py` loads .env then .env.local
# from the plugin repo root automatically (shell exports still win). Set LLM_WIKI_SKIP_DOTENV=1
# to disable. You can still use: source .env.local  or  direnv  if you prefer.

# ── Web search ───────────────────────────────────────────────────────────────
# Brave Search API — web/news/llm-context/answers modes (best for RAG grounding)
# Free key: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# ── Web scraping ─────────────────────────────────────────────────────────────
# Firecrawl — clean markdown from any URL (CLI or REST API)
# Get a free key: https://firecrawl.dev/app/api-keys
# Install CLI:    npm install -g firecrawl-cli && firecrawl login
FIRECRAWL_API_KEY=

# ── AI research ──────────────────────────────────────────────────────────────
# Perplexity — AI-powered research queries
# Get a key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Social / data MCPs ───────────────────────────────────────────────────────
# Twitter/X auth_token cookie — for bird CLI (tweet/thread/search/timeline ingest)
# Get it: Twitter → DevTools → Application → Cookies → auth_token
# Install bird: npm install -g @steipete/bird
# NOTE: FxTwitter API works zero-config for public tweets (no token needed)
TWITTER_AUTH_TOKEN=

# ── LLM backends ─────────────────────────────────────────────────────────────
# Anthropic (used by pdf_vision adapter and LLM-triage features)
ANTHROPIC_API_KEY=

# OpenAI (embeddings, adapters, and benchmark LLM rerank when rerank_llm.invoke is openai_api)
OPENAI_API_KEY=

# ── Vault override ───────────────────────────────────────────────────────────
# Override the vault path discovered by the CLI (useful when running outside the project)
# LLM_WIKI_VAULT=/path/to/your/project/llm-wiki

# ── Benchmark LLM rerank ─────────────────────────────────────────────────────
# Set to 1 to enable LLM-based reranking during benchmark runs
# LLM_WIKI_BENCHMARK_LLM=1

# ── Anna's Archive ───────────────────────────────────────────────────────────
# API key for Anna's Archive integration (ebook/paper ingest)
# ANNAS_ARCHIVE_KEY=
