# wiki-llm integration API keys
#
# ── Claude Code + this plugin ────────────────────────────────────────────────
# Prefer project-local:  .claude/settings.local.json  (gitignored — put secrets here)
# Or global:             ~/.claude/settings.json
# In that JSON, use an "env" block so tools inherit the same variables as below.
# Ask Claude to open the file and add the keys (empty strings) so you can paste values.
#
# Example shape:
#   {
#     "env": {
#       "BRAVE_SEARCH_API_KEY": "",
#       "FIRECRAWL_API_KEY": "",
#       "PERPLEXITY_API_KEY": "",
#       "TWITTER_AUTH_TOKEN": "",
#       "ANTHROPIC_API_KEY": "",
#       "OPENAI_API_KEY": ""
#     }
#   }
#
# ── Terminal / scripts / pytest ───────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
#
# Load in your shell:  source .env.local
# Or use direnv:       echo 'dotenv .env.local' >> .envrc

# ── Web search ───────────────────────────────────────────────────────────────
# Brave Search API — web/news/llm-context/answers modes (best for RAG grounding)
# Free key: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# ── Web scraping ─────────────────────────────────────────────────────────────
# Firecrawl — clean markdown from any URL (CLI or REST API)
# Get a free key: https://firecrawl.dev/app/api-keys
# Install CLI:    npm install -g firecrawl-cli && firecrawl login
FIRECRAWL_API_KEY=

# ── AI research ──────────────────────────────────────────────────────────────
# Perplexity — AI-powered research queries
# Get a key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Social / data MCPs ───────────────────────────────────────────────────────
# Twitter/X auth_token cookie — for bird CLI (tweet/thread/search/timeline ingest)
# Get it: Twitter → DevTools → Application → Cookies → auth_token
# Install bird: npm install -g @steipete/bird
# NOTE: FxTwitter API works zero-config for public tweets (no token needed)
TWITTER_AUTH_TOKEN=

# ── LLM backends ─────────────────────────────────────────────────────────────
# Anthropic (used by pdf_vision adapter and LLM-triage features)
ANTHROPIC_API_KEY=

# OpenAI (future adapter / embedding support)
OPENAI_API_KEY=
